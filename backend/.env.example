# Database
DATABASE_URL=postgresql://leadforge:leadforge@localhost:5432/leadforge_db
# For local dev without PostgreSQL, use SQLite:
# DATABASE_URL=sqlite:///./leadforge.db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Provider (options: gemini, openai, fallback)
AI_PROVIDER=fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# App
APP_ENV=development
DEBUG=true
